{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevTools",
  "version": "0.1.0",
  "identifier": "com.lotusandcompanyinc.dev-tools.tauri-preview",
  "build": {
    "beforeDevCommand": "bun run dev:tauri",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build:tauri",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevTools",
        "width": 1280,
        "height": 800,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Developer utility collection",
    "icon": ["../res/dev-tools.icns", "../res/dev-tools_logo.png"]
  }
}
