[
  {
    "input": {"type":"text","parameters":{"text_content":"bridge test"}},
    "expected": {"content":"bridge test"}
  },
  {
    "input": {"type":"url","parameters":{"url_content":"https://example.com"}},
    "expected": {"content":"https://example.com"}
  },
  {
    "input": {"type":"email","parameters":{"email_address":"a@example.com"}},
    "expected": {"content":"mailto:a@example.com"}
  },
  {
    "input": {"type":"phone","parameters":{"phone_number":"09012345678"}},
    "expected": {"content":"tel:09012345678"}
  },
  {
    "input": {"type":"sms","parameters":{"sms_phone":"09012345678","sms_message":"Hello"}},
    "expected": {"content":"SMSTO:09012345678:Hello"}
  },
  {
    "input": {"type":"wifi","parameters":{"wifi_ssid":"DevTools","wifi_password":"secret","wifi_security":"WPA","wifi_hidden":"false"}},
    "expected": {"content":"WIFI:T:WPA;S:DevTools;P:secret;;"}
  },
  {
    "input": {"type":"contact","parameters":{"contact_name":"Alice","contact_phone":"09012345678","contact_email":"alice@example.com"}},
    "expected": {"content":"BEGIN:VCARD\nVERSION:3.0\nFN:Alice\nTEL:09012345678\nEMAIL:alice@example.com\nEND:VCARD"}
  },
  {
    "input": {"type":"calendar","parameters":{"cal_summary":"Review","cal_start":"2026-10-29T10:00","cal_end":"2026-10-29T11:00"}},
    "expected": {"content":"BEGIN:VEVENT\nSUMMARY:Review\nDTSTART:20261029T100000\nDTEND:20261029T110000\nEND:VEVENT"}
  },
  {
    "input": {"type":"geo","parameters":{"geo_lat":"35.681236","geo_lng":"139.767125"}},
    "expected": {"content":"geo:35.681236,139.767125"}
  }
]
