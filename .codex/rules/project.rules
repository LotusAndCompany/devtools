# Project-level command rules for Codex
# Format: Starlark prefix_rule() — see https://developers.openai.com/codex/rules

prefix_rule(
    pattern = ["bun"],
    decision = "allow",
    justification = "Tauri frontend development, checks, and packaging",
)

prefix_rule(
    pattern = ["cargo"],
    decision = "allow",
    justification = "Rust formatting, linting, tests, and documentation",
)

prefix_rule(
    pattern = ["pre-commit"],
    decision = "allow",
    justification = "Repository quality hooks",
)

prefix_rule(
    pattern = ["python3", "scripts/sync-agent-rules.py"],
    decision = "allow",
    justification = "Regenerate tool-specific adapters from shared agent rules",
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "View working tree status",
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "View commit history",
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "View changes",
)

prefix_rule(
    pattern = ["git", "branch"],
    decision = "allow",
    justification = "View or manage branches",
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "prompt",
    justification = "Stage changes — review before committing",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Create commits — review message and staged changes",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push branch to a remote",
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force push can overwrite remote history",
)

prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force push can overwrite remote history",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset discards uncommitted work",
)
